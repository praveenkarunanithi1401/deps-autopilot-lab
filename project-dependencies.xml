<?xml version="1.0" encoding="UTF-8"?>
<!--
  Library declarations in the same Ant format Learn uses.
  generated/ is produced from this file by: python3 bin/generate_gradle.py
-->
<project name="project-dependencies" default="help">

  <target name="-declare-libraries">

    <!-- Shared version properties (one property feeds several libraries) -->
    <property name="jackson.version" value="2.17.0"/> <!-- Sync with library-versions.gradle -->
    <property name="log4j.version" value="2.23.0"/>
    <property name="tomcat.version" value="11.0.0"/>

    <!-- Literal versions -->
    <declare-lib key="commons-io"
                 category="commons"
                 location="${compilelib}/commons-io.jar"
                 version="2.15.0"
                 description="Commons IO utilities"
                 groupId="commons-io"
                 artifactId="commons-io"
                 scope="api"/>

    <declare-lib key="guava"
                 category="system"
                 location="${compilelib}/guava.jar"
                 version="33.0.0-jre"
                 description="Google core libraries"
                 groupId="com.google.guava"
                 artifactId="guava"
                 scope="api"/>

    <declare-lib key="mockito"
                 location="${devtools}/mockito-core.jar"
                 version="5.10.0"
                 description="Mock objects library for java."
                 groupId="org.mockito"
                 artifactId="mockito-core"
                 libDepends="byte-buddy"/>

    <declare-lib key="byte-buddy"
                 location="${devtools}/byte-buddy.jar"
                 version="1.14.12"
                 description="Runtime code generation"
                 groupId="net.bytebuddy"
                 artifactId="byte-buddy"/>

    <!-- Property-driven versions -->
    <declare-lib key="jackson-core"
                 category="system"
                 location="${compilelib}/jackson-core.jar"
                 version="${jackson.version}"
                 groupId="com.fasterxml.jackson.core"
                 artifactId="jackson-core"
                 scope="api"/>

    <declare-lib key="jackson-databind"
                 category="system"
                 location="${compilelib}/jackson-databind.jar"
                 version="${jackson.version}"
                 groupId="com.fasterxml.jackson.core"
                 artifactId="jackson-databind"
                 scope="api"/>

    <declare-lib key="log4j-core"
                 category="system"
                 location="${compilelib}/log4j-core.jar"
                 version="${log4j.version}"
                 groupId="org.apache.logging.log4j"
                 artifactId="log4j-core"
                 scope="api"/>

    <!-- Must never be automated (manual procedure) -->
    <declare-lib key="tomcat-jdbc"
                 category="jdbc"
                 location="${compilelib}/jdbc/tomcat-jdbc.jar"
                 version="${tomcat.version}"
                 groupId="org.apache.tomcat"
                 artifactId="tomcat-jdbc"/>

    <!-- Internal fork: must never be automated -->
    <declare-lib key="commons-chain-bb"
                 location="${compilelib}/commons-chain-bb.jar"
                 version="1.2-bb-1"
                 groupId="commons-chain"
                 artifactId="commons-chain-bb"/>

  </target>

  <target name="-declare-plugins">
    <!-- Internal plugin: version comes from a range, never automated -->
    <declare-plugin groupId="com.example.plugin" artifactId="portal" version="${platform.version.range}"/>
  </target>

</project>
