{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "deps-autopilot-lab: Renovate rehearsal for Learn-style dependency files",

  // Same prefix Learn needs so its Jenkins job builds bot branches
  branchPrefix: "feature/renovate/",
  baseBranchPatterns: ["main"],

  enabledManagers: ["custom.regex", "gradle"],
  ignorePaths: [
    // Generated by bin/generate_gradle.py - never edit directly
    "generated/**",
  ],

  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dependency Dashboard (lab)",
  dependencyDashboardApproval: true, // tick a box before a branch is created
  prConcurrentLimit: 2,
  prHourlyLimit: 0, // lab only; Learn uses 1
  rebaseWhen: "conflicted",
  separateMajorMinor: true,
  automerge: false,
  minimumReleaseAge: "14 days",
  internalChecksFilter: "strict",
  timezone: "Asia/Kolkata",
  labels: ["dependencies", "renovate"],
  configMigration: true,

  customManagers: [
    {
      customType: "regex",
      description: "project-dependencies.xml: <declare-lib> with a literal version",
      managerFilePatterns: ["/^project-dependencies\\.xml$/"],
      matchStrings: [
        "<declare-(?:lib|birt-lib)\\s[^>]*?version=\"(?<currentValue>[^\"$]+)\"[^>]*?groupId=\"(?<groupId>[^\"]+)\"[^>]*?artifactId=\"(?<artifactId>[^\"]+)\"",
      ],
      depNameTemplate: "{{{groupId}}}:{{{artifactId}}}",
      datasourceTemplate: "maven",
    },
    {
      customType: "regex",
      description: "project-dependencies.xml: jackson.version property",
      managerFilePatterns: ["/^project-dependencies\\.xml$/"],
      matchStrings: ["<property name=\"jackson\\.version\" value=\"(?<currentValue>[^\"]+)\"\\s*/>"],
      depNameTemplate: "com.fasterxml.jackson:jackson-bom",
      datasourceTemplate: "maven",
    },
    {
      customType: "regex",
      description: "library-versions.gradle: commonsIO key",
      managerFilePatterns: ["/^distribution/includes/library-versions\\.gradle$/"],
      matchStrings: ["\\n\\s+commonsIO: '(?<currentValue>[^']+)'"],
      depNameTemplate: "commons-io:commons-io",
      datasourceTemplate: "maven",
    },
    {
      customType: "regex",
      description: "library-versions.gradle: jackson key",
      managerFilePatterns: ["/^distribution/includes/library-versions\\.gradle$/"],
      matchStrings: ["\\n\\s+jackson: '(?<currentValue>[^']+)'"],
      depNameTemplate: "com.fasterxml.jackson:jackson-bom",
      datasourceTemplate: "maven",
    },
  ],

  packageRules: [
    // 1. Deny everything by default
    { matchPackageNames: ["*"], enabled: false },
    // 2. Allow-list. Do NOT add matchUpdateTypes here: enabled is decided before
    //    Renovate knows the update type, so such a rule can never re-enable a package.
    {
      matchPackageNames: ["commons-io:commons-io"],
      enabled: true,
      groupName: "commons-io",
    },
    {
      matchPackageNames: ["com.fasterxml.jackson:jackson-bom"],
      enabled: true,
      groupName: "jackson",
      allowedVersions: "<3.0.0", // Jackson 3 changes package names
    },
    // 3. No major versions (must come AFTER the allow-list)
    { matchUpdateTypes: ["major"], enabled: false },
    // 4. Regenerate generated/ on every Renovate branch (Learn: ./build gradle)
    {
      matchManagers: ["custom.regex", "gradle"],
      postUpgradeTasks: {
        commands: ["python3 bin/generate_gradle.py"],
        fileFilters: ["generated/**"],
        executionMode: "branch",
      },
    },
    // 5. Never automate these (last, so nothing can re-enable them)
    {
      matchPackageNames: ["org.apache.tomcat:**", "com.example**"],
      enabled: false,
    },
    {
      matchCurrentValue: "/(-bb-|-bb$|\\.bb|SNAPSHOT)/",
      enabled: false,
    },
  ],
}
